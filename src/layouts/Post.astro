---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = Omit<CollectionEntry<"blog">["data"], "draft">;

const { title, description, pubDate, updatedDate } = Astro.props;
---

<Base title={title} description={description} ogType="article">
  <article>
    <header class="mb-10">
      <h1 class="font-display text-title font-bold leading-snug">{title}</h1>
      <p class="mt-3 text-meta text-text-muted">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <span>
              {" "}
              · updated <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  <p class="mt-16 text-nav font-display">
    <a
      href="/blog/"
      class="text-text-muted transition-colors duration-150 hover:text-accent"
      >&larr; All posts</a
    >
  </p>
</Base>
