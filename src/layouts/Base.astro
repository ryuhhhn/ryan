---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = "Ryan Toh, CS student at NUS",
  ogType = "website",
} = Astro.props;

const pageTitle = title ? `${title} — Ryan Toh` : "Ryan Toh";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="mx-auto flex min-h-[80vh] max-w-160 flex-col px-6 py-16">
      <header
        class="mb-14 flex flex-wrap items-baseline justify-between gap-y-3"
      >
        <a
          href="/"
          class="font-display text-title font-bold tracking-widest transition-colors duration-150 hover:text-accent"
        >
          RYAN TOH
        </a>
        <NavBar />
      </header>

      <main class="grow">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
